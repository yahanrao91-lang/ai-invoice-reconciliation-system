# 复制本文件为 .env 并按需填写。真实 API Key 绝不写入代码或提交到 Git。

# ---------- LLM（OpenAI-Compatible Chat Completions） ----------
# 所有真实外部模型调用必须由用户主动启用：将 LLM_ENABLED 设为 1 并填写下方三项。
LLM_ENABLED=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- OCR（本地中文 OCR） ----------
# 引擎可选：rapidocr（默认，自包含 ONNX）、paddleocr、tesseract
OCR_ENABLED=1
OCR_ENGINE=rapidocr

# ---------- 数据目录（默认本地 data/） ----------
APP_DATA_DIR=data
